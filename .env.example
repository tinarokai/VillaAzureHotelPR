# Template only - no real values here.
# Copy this file to .env and fill it in. .env is gitignored and must never be committed.
#
# Secrets that are NOT in this file (Cloudflare Pages > Settings > Variables and secrets):
#   EMAIL_API_TOKEN - encrypted in Cloudflare, do not put it in .env

# Supabase - publishable/anon values, safe to expose in the browser
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
